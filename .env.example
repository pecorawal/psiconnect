# ===========================================================================
# PsiConnect -- copie para .env  (cp .env.example .env)
#
# Este arquivo carrega INFRAESTRUTURA e SEGREDOS. Regras de negócio mutáveis
# em runtime (comissão, limites) vivem na tabela ParametroSistema; os valores
# abaixo são apenas o bootstrap do seed.
# ===========================================================================

APP_ENV=dev
APP_NOME=PsiConnect
APP_SECRET_KEY=troque-em-producao-use-no-minimo-32-bytes-aleatorios
APP_BASE_URL=http://localhost:8000
APP_DEBUG=true

# --- Banco -----------------------------------------------------------------
# Porta 5433 evita colidir com um Postgres já instalado no host.
DATABASE_URL=postgresql+psycopg://psiconnect:psiconnect@localhost:5433/psiconnect
DATABASE_ECHO=false

TZ_PADRAO=America/Sao_Paulo

# --- Parâmetros de negócio (bootstrap do seed) -----------------------------
# Cobre os custos de API por sessão (vídeo + transcrição) e a infra fixa.
# Ver docs/adr/0005-comissao-parametrizavel.md para a conta.
COMISSAO_PERCENTUAL_PADRAO=12.0
DURACAO_SESSAO_PADRAO_MIN=50
INTERVALO_ENTRE_SESSOES_MIN=10
LIMITE_HORAS_DIA_PROFISSIONAL=10
LIMITE_SESSOES_SEMANA_PACIENTE=3
SUGESTAO_MAX_SEMANA=2
TOLERANCIA_ATRASO_MIN=15
ANTECEDENCIA_LINK_MIN=20
JANELA_PONTUALIDADE_MIN=5
TTL_RESERVA_PAGAMENTO_MIN=15
MAX_ESPECIALIDADES_PROFISSIONAL=5

# --- Providers: fake | real ------------------------------------------------
PAGAMENTO_PROVIDER=fake
VIDEO_PROVIDER=fake
NOTIFICACAO_PROVIDER=console
TRANSCRICAO_PROVIDER=fake
EMBEDDING_PROVIDER=fake
NOTAFISCAL_PROVIDER=fake

# --- Mercado Pago (Fase 2) -------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# --- daily.co (Fase 4) -----------------------------------------------------
DAILY_API_KEY=
DAILY_DOMAIN=

# --- E-mail (Mailpit em dev: UI em http://localhost:8025) ------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=false
EMAIL_REMETENTE=nao-responda@psiconnect.com.br

# --- WhatsApp Cloud API (Fase 3) -------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# --- Transcrição e embeddings (Fase 5) -------------------------------------
# Trocar EMBEDDING_DIM exige nova migration + re-embedding. Ver ADR 0003.
EMBEDDING_DIM=1536
OPENAI_API_KEY=
# base64 de 32 bytes (AES-256-GCM). Gerar com:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CHAVE_CRIPTO_TRANSCRICAO=

# --- Armazenamento ---------------------------------------------------------
# local = disco (só dev) | s3 = MinIO ou qualquer storage S3-compatível
ARMAZENAMENTO_PROVIDER=s3
ARMAZENAMENTO_LOCAL_DIR=./storage_local

# MinIO do docker-compose. Em produção, troque por credenciais próprias.
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=psiconnect
S3_SECRET_KEY=psiconnect-dev-secret
S3_BUCKET=psiconnect
S3_REGION=us-east-1
S3_PATH_STYLE=true
# Link assinado de foto de perfil vale só o tempo de a página carregar.
S3_URL_TTL_SEGUNDOS=60

# Webhook: URL pública que o Mercado Pago precisa alcançar. Em dev, use um túnel
# (`cloudflared tunnel --url http://localhost:8000`) e cadastre a URL no painel.
# O segredo é gerado no painel do MP, em "Webhooks" -> "Assinatura secreta".
